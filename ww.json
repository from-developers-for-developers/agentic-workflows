{
  "enabled": true,
  "runtime": "single",
  "update_check": true,
  "executable": "ww-agentic-workflows",
  "task_format": "TASK-{{digit}}",
  "limits": {
    "rounds": 3,
    "fixes": 3
  },
  "agent_hooks": {
    "check_unfinished": true,
    "recent_days": 3
  },
  "rules": {
    "approval": "operator"
  },
  "builtins": {
    "init": {
      "model": "cheapest",
      "reasoning": "low"
    },
    "workflow_summary": {
      "model": "auto",
      "reasoning": "auto"
    }
  },
  "workflows": {},
  "projects": [],
  "extensions": {
    "ww/git": {
      "commit_format": "{{ww.task.id}}: {{commit_message}}",
      "separate_branch": true,
      "base_branches": {
        "default": "dev",
        "hotfix": "main",
        "bugfix": "dev"
      },
      "branch_name_formats": {
        "default": "feature/{{ww.task.id}}",
        "hotfix": "hotfix/{{ww.task.id}}"
      },
      "worktrees": true,
      "worktree_dir": "./ww-worktrees",
      "worktree_name_format": "{{ww.task.id}}"
    }
  }
}
